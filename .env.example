# ==============================================================================
# HRM Portal — Environment Variables Template
# ==============================================================================
# Copy this file to .env and configure your environment-specific settings.
# NEVER commit the real .env file with live secrets to Git.
# ==============================================================================

# Server Configuration
SERVER_PORT=8080
FRONTEND_BASE_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Database Configuration (PostgreSQL / H2)
DATABASE_URL=jdbc:h2:mem:hrm_portal;MODE=PostgreSQL;DB_CLOSE_DELAY=-1;DB_CLOSE_ON_EXIT=FALSE
DATABASE_USERNAME=sa
DATABASE_PASSWORD=

# Security & Authentication
JWT_SECRET=your_jwt_secret_key_here_must_be_sufficiently_long_and_secure
JWT_EXPIRATION=86400000

# ==============================================================================
# AI Provider Configuration
# ==============================================================================
# Select provider: openai | gemini | anthropic | fallback
AI_PROVIDER=openai

# OpenAI Provider Configuration (Required when AI_PROVIDER=openai)
# Set your API key in environment or export: export OPENAI_API_KEY="sk-..."
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Google Gemini Provider Configuration (Optional)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Anthropic Claude Provider Configuration (Optional)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Demo / Seeding Configuration (Dev-only)
SEED_DEMO_ACCOUNTS=false
DEMO_ACCOUNT_PASSWORD=
SEED_ENTERPRISE_DEMO=false
