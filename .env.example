# TEMPLATE ONLY: copy to .env for local development and replace the marked values.
# Do not commit .env. Do not use these placeholders for a deployed environment.

SERVER_PORT=8080
FRONTEND_BASE_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000

# Local H2 database; keep the URL quoted because it contains semicolons.
DATABASE_URL="jdbc:h2:mem:hrm_portal;MODE=PostgreSQL;DB_CLOSE_DELAY=-1;DB_CLOSE_ON_EXIT=FALSE"
DATABASE_USERNAME=sa
DATABASE_PASSWORD=

# Replace with the output of: openssl rand -base64 32
JWT_SECRET=REPLACE_WITH_A_NEW_RANDOM_SECRET
JWT_EXPIRATION=86400000

# Use fallback for local development without a paid external AI API.
# Options supported by the application may include openai, gemini, anthropic, and fallback.
AI_PROVIDER=fallback

# Keep provider keys blank unless you have configured and authorized the provider.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Demo account creation is disabled by default in this template.
# If enabling demo accounts locally, set a unique password first.
SEED_DEMO_ACCOUNTS=false
DEMO_ACCOUNT_PASSWORD=CHANGE_ME_FOR_LOCAL_DEVELOPMENT
SEED_ENTERPRISE_DEMO=false
