# Application
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080
SEED_DEMO_ACCOUNTS=false
DEMO_ACCOUNT_PASSWORD=
# Required: a unique Base64-encoded secret of at least 32 bytes for HS256.
# Example generator: openssl rand -base64 32
JWT_SECRET=
JWT_EXPIRATION=86400000
FRONTEND_URL=http://localhost:5173

# Database
DATABASE_URL=jdbc:postgresql://localhost:5432/hrm_portal
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=
HIBERNATE_DDL_AUTO=update
FLYWAY_ENABLED=true
SHOW_SQL=false
FORMAT_SQL=false

# Mail
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS=false

# Storage
UPLOAD_DIR=uploads
STORAGE_BUCKET=hrm-portal-dev
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# Payment / external services
PAYMENT_PROVIDER_KEY=

# Logger
LOG_LEVEL_ROOT=INFO
LOG_LEVEL_APP=INFO
LOG_LEVEL_SECURITY=INFO
